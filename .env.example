# Local development only. Non-secret defaults; copy to .env and adjust if needed.
# Never commit a real .env file.

# --- PostgreSQL (shared server, one database per service; see migrations/README.md) ---
POSTGRES_USER=outbox_dev
POSTGRES_PASSWORD=outbox_dev_password
POSTGRES_HOST=localhost
# 55432, not the 5432 default: this machine commonly has another project's
# Postgres already bound to 5432. The container still listens on 5432
# internally; only the host-side mapping changes.
POSTGRES_PORT=55432
POSTGRES_ORDERS_DB=orders
POSTGRES_INVENTORY_DB=inventory
POSTGRES_PAYMENTS_DB=payments
POSTGRES_FULFILMENT_DB=fulfilment

# --- Redpanda (Kafka-compatible broker) ---
REDPANDA_BROKER=localhost:19092
REDPANDA_CONSOLE_PORT=8090

# --- Service HTTP ports ---
ORDERS_PORT=8081
INVENTORY_PORT=8082
PAYMENTS_PORT=8083
FULFILMENT_PORT=8084

# --- Environment name; failure injection refuses to enable when this is "production" ---
ENVIRONMENT=development

# --- Failure injection (must stay false outside dev/test; see spec section 17) ---
FAILURE_INJECTION_ENABLED=false
# Dev-only bearer token required by PUT/DELETE /_test/faults/*. Non-secret
# local default; every real deployment must override it.
FAILURE_INJECTION_TOKEN=dev-only-fault-token

# --- Delivery mode (see spec section 11). "naive" is the only real mode
# until M03 adds the transactional outbox, which then becomes the default. ---
DELIVERY_MODE=naive
